#!/usr/bin/env bash
# Runs a heavy local command (tsc -b, eslint ., a whole web/ui suite, vite build) with at most
# ROOFLINE_HEAVY_SLOTS (default 2) running at a time across every worktree on this machine, so a
# 4-CPU cloud box is not swamped by parallel agents. Usage: slot npm run typecheck
set -u
SLOTS=${ROOFLINE_HEAVY_SLOTS:-2}
ROOT=/tmp/roofline-heavy-slots
mkdir -p "$ROOT"
waited=0
while :; do
  for i in $(seq 1 "$SLOTS"); do
    d="$ROOT/slot-$i"
    if mkdir "$d" 2>/dev/null; then
      echo $$ > "$d/pid"
      trap 'rm -rf "$d"' EXIT INT TERM
      [ "$waited" -gt 0 ] && echo "[slot] got slot $i after ${waited}s" >&2
      "$@"
      exit $?
    fi
    pid=$(cat "$d/pid" 2>/dev/null)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then rm -rf "$d"; fi
  done
  [ $((waited % 60)) -eq 0 ] && echo "[slot] waiting for a heavy-command slot (${waited}s)" >&2
  sleep 3; waited=$((waited + 3))
done
