{
  "name": "roofline-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\" \"apps/web/src/**/*.css\" --allow-empty-input",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run migrate -w @roofline/db",
    "db:generate": "npm run generate -w @roofline/db",
    "dev:worker": "npm run dev -w @roofline/worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.12.0",
    "postcss-value-parser": "^4.2.0",
    "stylelint": "^17.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
