HOST=127.0.0.1
PORT=4311
DATABASE_PATH=./data/roofline.sqlite
# Local demo only. Production requires DEMO_MODE=false and a password of 12+ characters.
DEMO_MODE=true
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
# Optional separate, high-entropy CLI bearer token (at least 32 characters).
API_TOKEN=
GOOGLE_MAPS_API_KEY=
RENTCAST_API_KEY=
# EagleView legacy WebServices integration; account/API entitlement required.
EAGLEVIEW_ACCESS_TOKEN=
EAGLEVIEW_ENV=sandbox
NODE_ENV=development

# Property Data v2 sandbox only. Separate from legacy WebServices credentials.
EAGLEVIEW_CLIENT_ID=
EAGLEVIEW_CLIENT_SECRET=
