# Roofline platform environment (packages/ and apps/; v1/ has its own .env).
#
# Copy to .env for local use (.env is git-ignored; never commit it), or set the same names in the
# host's environment settings (Render: the service's Environment tab). The processes do not read a
# .env file themselves: export it first, for example `set -a; . ./.env; set +a; npm start -w @roofline/api`.
#
# Every value below is a placeholder, not a secret. The database URLs point at the local compose DB
# (`npm run db:up`); in production use the host's URLs. Blank lines such as `POSTMARK_TOKEN=` count
# as unset.

# =================================================================================================
# API and worker. apps/api/src/config.ts (loadConfig) reads these; the API and the worker need the
# same set. A missing or malformed required variable stops the process with its name (never its value).
# =================================================================================================

# REQUIRED. development, test or production. production also makes HOST default to 0.0.0.0.
NODE_ENV=development

# REQUIRED. The one origin the web app is served from (links in emails; mutations from any other
# Origin are refused). An http(s) URL; only its origin is kept. It must be the origin the BROWSER
# shows, because that is the Origin header it sends: in development that is Vite's
# (`npm run dev:web`, http://127.0.0.1:4401, which proxies /api to the API on 4400); in production
# it is the API's own public URL, since the API serves the app (see WEB_DIST_DIR).
APP_ORIGIN=http://127.0.0.1:4401

# REQUIRED. Public base URL of this API, no trailing slash: email links and the Twilio webhook URLs
# (their signatures are checked against it, so it must be exactly what Twilio calls).
PUBLIC_BASE_URL=http://127.0.0.1:4400

# REQUIRED. The app_tenant login (all request work, under row-level security).
DATABASE_URL_TENANT=postgres://app_tenant:change-me-tenant@127.0.0.1:54329/roofline

# REQUIRED. The app_system login (auth, webhook routing, the scheduler fan-out, and pg-boss).
DATABASE_URL_SYSTEM=postgres://app_system:change-me-system@127.0.0.1:54329/roofline

# REQUIRED. 32 random bytes, base64: `openssl rand -base64 32`. Encrypts secrets kept in the database
# (texting subaccount tokens). Keep it: a new key cannot read what the old one encrypted.
ENCRYPTION_KEY=

# Optional. Google OAuth client id; unset turns Sign in with Google off (those calls answer 503).
GOOGLE_CLIENT_ID=

# Optional. Postmark server token; unset means email is logged, not sent (a warning in production).
POSTMARK_TOKEN=

# Optional; REQUIRED when POSTMARK_TOKEN is set. The verified From address, e.g. `Roofline <hello@example.com>`.
MAIL_FROM=

# Optional. Where the built web app is (`npm run build:web` writes apps/web/dist). When set, the API
# also serves the app (its files, and index.html for every page address), so one process answers the
# app and the API: set it to apps/web/dist in production. It must be a directory that contains
# index.html, or the process stops at start-up naming this variable. A relative path is read from the
# repository root. Unset in development, where Vite serves the app. The worker reads the same
# environment, so it checks the path too.
WEB_DIST_DIR=

# Optional. Twilio master auth token: checks webhook signatures for companies without a subaccount token.
TWILIO_AUTH_TOKEN=

# Optional, default 0. How many reverse-proxy hops in front of the API to trust for the client
# address (`req.ip`: the rate limits and the audit log use it). Set it to the number of proxies your
# host puts in front; 0 behind a proxy makes every client look like the proxy.
TRUST_PROXY=0

# Optional, default 600. Requests per minute per session on /api/*.
API_RATE_LIMIT_PER_MIN=600

# Optional, default 4400. The port to listen on (Render sets PORT itself).
PORT=4400

# Optional. The address to listen on. Unset: 0.0.0.0 when NODE_ENV=production (the host's health
# check must reach it), otherwise 127.0.0.1. A value set here always wins.
HOST=

# =================================================================================================
# Migrations and role passwords (packages/db: `npm run db:migrate`, `npm run set-role-passwords
# -w @roofline/db`). Only these one-off steps need them; the API and the worker never do.
# =================================================================================================

# REQUIRED in production (unset: the local compose DB). The migration owner: it owns the tables and
# creates the app roles, so it needs CREATEROLE and CREATE on the database (owning it is simplest).
# Never give this URL to the API or the worker.
DATABASE_URL_OWNER=postgres://roofline:roofline@127.0.0.1:54329/roofline

# REQUIRED for set-role-passwords. The passwords it sets on app_tenant and app_system; they must match
# the ones in DATABASE_URL_TENANT and DATABASE_URL_SYSTEM.
TENANT_DB_PASSWORD=change-me-tenant
SYSTEM_DB_PASSWORD=change-me-system
